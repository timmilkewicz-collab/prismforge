#ifndef QUALITY_TIER
#define QUALITY_TIER 0
#endif

cbuffer SceneInputs : register(b0) {
  float time;
  float bass;
  float mids;
  float highs;
  float hit;
  float2 resolution;
  float4 reactive;
  float4 sceneParams;
  float4 musicalA;
  float4 musicalB;
};

struct PSInput {
  float4 position : SV_POSITION;
  float2 uv : TEXCOORD0;
};

float knee(float value) {
  float signal = max(saturate(value) - 0.004, 0.0);
  return signal / (signal + 0.04);
}

float4 main(PSInput input) : SV_TARGET {
  float2 uv = input.uv;
  float4 controls = saturate(sceneParams);
  float assist = musicalB.w;
  float sweep = lerp(0.4, 2.4, saturate(controls.x + assist * 0.2 * musicalA.y));
  float density = lerp(8.0, 36.0, saturate(controls.y + assist * 0.12 * (musicalA.z - 0.3)));
  float gain = lerp(0.4, 1.6, saturate(controls.z + assist * 0.15 * musicalB.x));
  float scan = controls.w;
  float low = knee(bass);
  float mid = knee(mids);
  float high = knee(highs);

  float2 gridUV = uv * float2(density, density * 0.56);
  float2 edge = min(frac(gridUV), 1.0 - frac(gridUV));
  float grid = 1.0 - smoothstep(0.0, 0.04, min(edge.x, edge.y));
  float3 color = float3(0.0, 0.012, 0.010);
  color += grid * float3(0.0, 0.045, 0.032) * (0.4 + scan);

  float x = uv.x;
  float clock = time * sweep;
  float wave = 0.62 + (0.10 + 0.08 * low) * gain * sin(x * 28.0 - clock);
  wave += 0.04 * gain * sin(x * 64.0 + clock * 1.7) * (0.3 + high);
  float route = 0.28 + 0.06 * gain * sin(x * 11.0 + clock * 0.45 + 1.2);
  float carrier = 0.78 + 0.05 * sin(floor(x * density) + clock);
  float d1 = abs(uv.y - wave);
  float d2 = abs(uv.y - route);
  float d3 = abs(uv.y - carrier);
  color += float3(0.15, 1.0, 0.62) * (1.0 - smoothstep(0.001, 0.005, d1));
  color += float3(0.05, 0.55, 0.85) * (1.0 - smoothstep(0.001, 0.004, d2)) * 0.7;
  color += float3(0.0, 0.35, 0.22) * (1.0 - smoothstep(0.001, 0.003, d3)) * scan;
  color += float3(0.0, 0.16, 0.08) * (0.008 / (d1 + 0.008));

  float column = floor(x * density);
  float bar = 0.02 + 0.16 * saturate(0.25 * low + 0.35 * mid + 0.4 * high +
      0.2 * sin(column * 1.7 + clock));
  float bars = step(uv.y, bar) * step(0.18, frac(x * density));
  color += bars * float3(0.02, 0.22, 0.14);
  float cursorX = frac(time * (0.05 + 0.12 * scan));
  color += (1.0 - smoothstep(0.0, 0.003, abs(x - cursorX))) * float3(0.2, 0.9, 0.5);
  color += saturate(hit) * float3(0.0, 0.05, 0.03);
  float aspect = resolution.x / max(resolution.y, 1.0);
  float2 p = (uv - 0.5) * float2(aspect, 1.0);
  float centerPres = pf_operator_center_pressure(controls);
  float2 c0;
  float2 c1;
  float2 c2;
  float2 c3;
  pf_four_centers(time, centerPres, c0, c1, c2, c3);
  color += exp(-length(p - c0) * 16.0) * float3(0.1, 0.85, 0.45) * centerPres * gain;
  color += exp(-length(p - c2) * 14.0) * float3(0.05, 0.45, 0.95) * centerPres;
  color = pf_center_rim(color, p, time, centerPres, float3(0.15, 1.0, 0.55), float3(0.05, 0.55, 0.85));
  color = pf_depth_structure(color, p, time, density * 0.04, sweep * 0.25);
  return float4(saturate(color), 1.0);
}
